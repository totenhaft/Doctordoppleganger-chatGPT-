# Copy to .env on the clinic PC. Paths may be quoted.
FFMPEG_PATH=ffmpeg
CAPTION_FONT=Malgun Gothic
PORT=8787

# Offline Korean voice and optional voice cloning
# TTS_PYTHON=C:\SolStudio\.venv-tts\Scripts\python.exe
# QWEN_TTS_MODEL=C:\SolStudio\models\qwen-tts
# QWEN_CLONE_MODEL=C:\SolStudio\models\qwen-clone
# VOICE_REFERENCES=C:\SolStudio\data\voices

# Offline portrait lip sync, optional
# MUSETALK_DIR=C:\MuseTalk
# MUSETALK_PYTHON=C:\MuseTalk\.venv\Scripts\python.exe

# Offline AI drafting and translation, optional
# OLLAMA_MODEL=qwen2.5:7b

# Optional multi-PC LAN mode. All four settings are required together.
# CLINIC_ORIGIN=https://192.168.1.20:8787
# CLINIC_PASSWORD=
# TLS_CERT_FILE=
# TLS_KEY_FILE=
