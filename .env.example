# Copy to .env on the clinic PC. Enter keys locally.
HEYGEN_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
FFMPEG_PATH=ffmpeg
CAPTION_FONT=Malgun Gothic
PORT=8787

